# Environment Variables for Patil Dealers (Nanded) Showroom

# 1. Supabase Backend Config (Get from your Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# 2. Resend Email Key (Used in Supabase Edge Function)
RESEND_API_KEY=re_1234567890abcdef

# 3. MSG91 SMS Key (Used in Supabase Edge Function)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_dlt_approved_template_id
# Enable SMS only after DLT template approval in India
ENABLE_SMS_NOTIFICATIONS=false

# 4. Showroom WhatsApp Notification Number
VITE_DEALER_WHATSAPP=919823456789
